<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="DotNetEnv" Version="3.2.0" />
      <PackageReference Include="MediatR" Version="12.4.1" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" PrivateAssets="all" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
      <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.15" />
      <PackageReference Include="Telegram.Bot" Version="22.10.4" />
      <EmbeddedResource Include="Assets/DashboardLogo.png" LogicalName="Bot.DashboardLogo.png" />
    </ItemGroup>

</Project>
